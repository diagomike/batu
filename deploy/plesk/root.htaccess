# Batu portal on Plesk (Apache). Written to httpdocs/.htaccess by tools/build.py.
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
# PHP behind Plesk's proxy does not always receive the Authorization header.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Forms on the static pages post to their own address; hand them to the PHP services.
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^(?:(om|am)/)?report/?$ api/report.php?lang=$1 [L,QSA]
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^(?:(om|am)/)?book/?$ api/book.php?lang=$1 [L,QSA]
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^(?:(om|am)/)?subscribe/?$ api/subscribe.php?lang=$1 [L,QSA]
RewriteCond %{REQUEST_METHOD} =POST
RewriteRule ^(?:(om|am)/)?services/([a-z0-9-]+)/apply/?$ api/apply.php?lang=$1&service=$2 [L,QSA]

# JSON API, same addresses as the Python server.
RewriteRule ^api/request/([A-Za-z0-9-]+)/?$ api/request.php?ref=$1 [L,QSA]
RewriteRule ^api/admin/requests/([A-Za-z0-9-]+)/?$ api/admin.php?action=request&ref=$1 [L,QSA]
RewriteRule ^api/admin/(requests|status|subscriptions)/?$ api/admin.php?action=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([a-z-]+)/?$ api/$1.php [L,QSA]

</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
<FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=300"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
