# Copy to .env and fill in.

# Free key from https://aistudio.google.com/apikey . Without it the assistant
# still works, but quotes city records instead of writing answers.
GEMINI_API_KEY=

# Optional: pin models (otherwise the app picks a Flash model and an embedding model your key can use)
GEMINI_MODEL=
GEMINI_EMBED_MODEL=

# Staff desk at /admin and the news push API (Authorization: Bearer <token>)
ADMIN_TOKEN=change-this-token

# demo = simulated Telebirr checkout; telebirr = your integration in app/payments.py
PAYMENT_PROVIDER=demo

# om, am or en. Use om once data/i18n/om.json is complete (python tools/translate.py)
DEFAULT_LANG=en

# Optional: official Google Cloud Translation key for tools/translate.py
GOOGLE_TRANSLATE_API_KEY=
